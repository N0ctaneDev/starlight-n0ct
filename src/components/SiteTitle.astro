---
import { Icon } from 'astro-icon/components';
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const match = siteTitle.match(/^\[([^\]]+)\]\s*/);
const iconName = match?.[1];
const label = match ? siteTitle.slice(match[0].length) : siteTitle;
const themeSettings = (Astro.locals as any).n0ctane?.theme ?? {};
const namedThemes = themeSettings.themes ?? [];
const hasThemeLogos = namedThemes.some((theme: { logo?: { dark?: string; light?: string } }) => theme.logo?.dark || theme.logo?.light);
const initialTheme = namedThemes.find((theme: { id: string }) => theme.id === themeSettings.defaultTheme) ?? namedThemes.find((theme: { logo?: { dark?: string; light?: string } }) => theme.logo?.dark || theme.logo?.light);
const initialThemeLogo = initialTheme?.logo?.dark ?? initialTheme?.logo?.light;
const baseUrl = import.meta.env.BASE_URL || '/';
const resolvePublicAsset = (path: string) => /^https?:/i.test(path) ? path : baseUrl + path.replace(/^\/+/, '');
const hasStarlightLogo = Boolean(config.logo && logos.dark);
const fallbackLogo = logos.dark?.src ?? (initialThemeLogo ? resolvePublicAsset(initialThemeLogo) : undefined);
---
<a href={siteTitleHref} class="site-title sl-flex n0ct-site-title">
  {config.logo && logos.dark && (
    <>
      <img
        class:list={{ 'light:sl-hidden print:hidden': !('src' in config.logo) }}
        data-n0ct-themed-logo
        data-n0ct-logo-fallback={logos.dark.src}
        alt={config.logo.alt}
        src={logos.dark.src}
        width={logos.dark.width}
        height={logos.dark.height}
      />
      {!('src' in config.logo) && logos.light && (
        <img
          class="dark:sl-hidden print:block"
          data-n0ct-themed-logo
          data-n0ct-logo-fallback={logos.light.src}
          alt={config.logo.alt}
          src={logos.light.src}
          width={logos.light.width}
          height={logos.light.height}
        />
      )}
    </>
  )}
  {!hasStarlightLogo && hasThemeLogos && fallbackLogo && (
    <img
      data-n0ct-themed-logo
      data-n0ct-logo-fallback={fallbackLogo}
      alt={config.logo?.alt ?? 'Site logo'}
      src={fallbackLogo}
    />
  )}
  <span class:list={{ 'sr-only': config.logo?.replacesTitle }} translate="no">
    {iconName && <Icon name={iconName} class="n0ct-site-title__icon" />}
    {label}
  </span>
</a>
<style>
  @layer starlight.components {
    .n0ct-site-title { align-items:center; gap:var(--sl-nav-gap); color:var(--sl-color-text-accent); text-decoration:none; white-space:nowrap; min-width:0; font-weight:750; letter-spacing:-.03em; }
    .n0ct-site-title span { display:inline-flex; align-items:center; gap:.48rem; overflow:hidden; }
    .n0ct-site-title img { height:calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y)); width:auto; max-width:100%; object-fit:contain; object-position:0 50%; }
    .n0ct-site-title__icon { flex:none; width:1.18rem; height:1.18rem; color:var(--sl-color-accent); }
    .n0ct-site-title:hover { color:var(--sl-color-accent); }
  }
</style>
