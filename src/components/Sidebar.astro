---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import TopicsDropdown from 'starlight-sidebar-topics-dropdown/TopicsDropdown.astro';
import TopicsList from 'starlight-sidebar-topics/components/Sidebar.astro';
import SidebarSublist from './SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;
const settings = (Astro.locals as any).n0ctane ?? {};
---
<SidebarPersister>
  <div class="n0ct-sidebar">
    <slot name="before-nav" />
    {settings.sidebar?.topicDisplay === 'list' && <TopicsList />}
    {settings.sidebar?.topicDisplay === 'dropdown' && (
      <div class="n0ct-sidebar-topic-switcher">
        <TopicsDropdown />
      </div>
    )}
    <nav aria-label="Main navigation">
      <SidebarSublist sublist={sidebar as any} nestedCount={0} />
    </nav>
  </div>
</SidebarPersister>
<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<script>
  const mobileMenuMedia = window.matchMedia('(max-width: 49.999rem)');
  const sidebarWindow = window as typeof window & { __n0ctSidebarMenuBound?: boolean };

  if (!sidebarWindow.__n0ctSidebarMenuBound) {
    sidebarWindow.__n0ctSidebarMenuBound = true;
    let n0ctSidebarPanel: HTMLElement | null = null;

    function isMobileMenuOpen() {
      return Boolean(
        mobileMenuMedia.matches &&
        n0ctSidebarPanel &&
        n0ctSidebarPanel.matches(':popover-open')
      );
    }

    let scrollButtonPositionFrame = 0;
    const scrollButtonBottomGap = 40;

    function updateScrollToTopButtonPosition() {
      scrollButtonPositionFrame = 0;

      const button = document.getElementById('scroll-to-top-button') as HTMLButtonElement | null;
      const mainFrame = document.querySelector<HTMLElement>('.main-frame');
      if (!button || !mainFrame || !mainFrame.contains(button)) return;

      // main-frame is transformed by starlight-sidebar-swipe. A fixed child
      // therefore uses main-frame as its containing block, not the viewport.
      // Recalculate its local top coordinate so it remains at the viewport
      // bottom while the document scrolls, yet still moves with main-frame
      // horizontally when the sidebar is swiped open.
      const frameTop = mainFrame.getBoundingClientRect().top;
      const viewportHeight = window.innerHeight;
      const top = viewportHeight - frameTop - button.getBoundingClientRect().height - scrollButtonBottomGap;

      button.style.setProperty('top', `${Math.max(0, top)}px`, 'important');
      button.style.setProperty('bottom', 'auto', 'important');
    }

    function scheduleScrollToTopButtonPosition() {
      if (scrollButtonPositionFrame) return;
      scrollButtonPositionFrame = window.requestAnimationFrame(updateScrollToTopButtonPosition);
    }

    function relocateScrollToTopButton() {
      const button = document.getElementById('scroll-to-top-button');
      const mainFrame = document.querySelector<HTMLElement>('.main-frame');

      // The scroll plugin appends this fixed button to body. Keep it inside the
      // page content layer so it follows the same transform as the page during
      // a sidebar swipe instead of remaining fixed over the revealed sidebar.
      if (button && mainFrame && !mainFrame.contains(button)) {
        mainFrame.appendChild(button);
      }
      scheduleScrollToTopButtonPosition();
    }

    function setN0ctMobileMenuState(open: boolean) {
      document.documentElement.toggleAttribute('data-n0ct-mobile-menu-open', open);

      const button = document.getElementById('scroll-to-top-button') as HTMLButtonElement | null;
      if (button) {
        // inert/aria-hidden prevent interaction; hidden also removes the fixed control visually.
        button.hidden = open;
        button.setAttribute('aria-hidden', String(open));
        button.inert = open;
      }
    }

    function syncN0ctMobileMenuState() {
      relocateScrollToTopButton();
      setN0ctMobileMenuState(isMobileMenuOpen());
    }

    function handleN0ctSidebarBeforeToggle(event: Event) {
      if (!mobileMenuMedia.matches) return;
      const nextState = (event as ToggleEvent).newState;
      // Hide before opening; let the post-toggle event restore the button after closing.
      if (nextState === 'open') setN0ctMobileMenuState(true);
    }

    function bindN0ctSidebarPanel() {
      const panel = document.getElementById('starlight__sidebar');
      if (panel !== n0ctSidebarPanel) {
        n0ctSidebarPanel?.removeEventListener('toggle', syncN0ctMobileMenuState);
        n0ctSidebarPanel?.removeEventListener('beforetoggle', handleN0ctSidebarBeforeToggle);
        n0ctSidebarPanel = panel;
        n0ctSidebarPanel?.addEventListener('toggle', syncN0ctMobileMenuState);
        n0ctSidebarPanel?.addEventListener('beforetoggle', handleN0ctSidebarBeforeToggle);
      }
      syncN0ctMobileMenuState();
    }

    const scrollButtonObserver = new MutationObserver(() => {
      // Rebind if Starlight replaces its popover and hide the button if the plugin
      // inserts it after the mobile menu has already opened.
      bindN0ctSidebarPanel();
    });
    scrollButtonObserver.observe(document.body, { childList: true });

    // Capture the popover event as well as Starlight's own panel toggle. This
    // covers the open/close sequence even when the button is inserted later.
    document.addEventListener('toggle', (event) => {
      if (event.target === n0ctSidebarPanel) requestAnimationFrame(syncN0ctMobileMenuState);
    }, true);
    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      const trigger = target.closest('[popovertarget="starlight__sidebar"], [aria-controls="starlight__sidebar"]');
      if (trigger) requestAnimationFrame(syncN0ctMobileMenuState);
    }, true);

    window.addEventListener('scroll', scheduleScrollToTopButtonPosition, { passive: true });
    window.addEventListener('resize', scheduleScrollToTopButtonPosition, { passive: true });
    window.visualViewport?.addEventListener('resize', scheduleScrollToTopButtonPosition, { passive: true });
    window.visualViewport?.addEventListener('scroll', scheduleScrollToTopButtonPosition, { passive: true });

    mobileMenuMedia.addEventListener('change', syncN0ctMobileMenuState);
    document.addEventListener('astro:page-load', bindN0ctSidebarPanel);
    bindN0ctSidebarPanel();
  }
</script>
