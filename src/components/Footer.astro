---
import Default from '@astrojs/starlight/components/Footer.astro';
import { Icon } from 'astro-icon/components';
const settings = (Astro.locals as any).n0ctane;
const footer = settings?.footer ?? {};
const links = footer.links ?? [];
const icons = footer.icons ?? [];
const baseUrl = import.meta.env.BASE_URL || '/';
const base = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
const resolveHref = (href: string) => href.startsWith('/') && !href.startsWith('//') ? `${base}${href}` : href;
---
<div class="n0ct-footer-wrap">
  <Default><slot /></Default>
  {(footer.text || links.length || icons.length) && (
    <footer class="n0ct-site-footer">
      <div class="n0ct-site-footer__brand">
        <a class="n0ct-site-footer__wordmark" href={Astro.locals.starlightRoute.siteTitleHref} aria-label="Back to home">N</a>
        <span>{footer.text ?? 'Documentation by N0ctane'}</span>
      </div>
      <nav class="n0ct-site-footer__links" aria-label="Footer links">
        {links.map((item: any) => <a href={resolveHref(item.link)} target={item.newTab ? '_blank' : undefined} rel={item.newTab ? 'noreferrer' : undefined}>{item.label}</a>)}
      </nav>
      <div class="n0ct-site-footer__icons">
        {icons.map((item: any) => (
          <a href={resolveHref(item.link)} aria-label={item.label ?? item.icon} title={item.label ?? item.icon} target={item.newTab ? '_blank' : undefined} rel={item.newTab ? 'noreferrer' : undefined}>
            <Icon name={item.icon} />
          </a>
        ))}
      </div>
    </footer>
  )}
</div>
<style>
  .n0ct-site-footer { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:1rem; padding:1.25rem 0 1.7rem; margin-top:1.1rem; border-top:1px solid var(--sl-color-hairline); color:var(--sl-color-gray-3); font-size:.82rem; }
  .n0ct-site-footer__brand,.n0ct-site-footer__links,.n0ct-site-footer__icons { display:flex; align-items:center; gap:.85rem; }
  .n0ct-site-footer__wordmark { display:grid; place-items:center; width:1.8rem; height:1.8rem; border-radius:.55rem; color:white; font-size:1rem; font-weight:800; text-decoration:none; background:var(--n0ct-brand-gradient); box-shadow:0 0 .9rem color-mix(in srgb,var(--n0ct-violet) 42%,transparent); }
  .n0ct-site-footer a:not(.n0ct-site-footer__wordmark) { color:var(--sl-color-gray-2); text-decoration:none; }
  .n0ct-site-footer a:hover { color:var(--sl-color-accent); }
  .n0ct-site-footer__icons a { display:grid; place-items:center; width:1.9rem; height:1.9rem; border:1px solid var(--sl-color-hairline); border-radius:.55rem; }
  .n0ct-site-footer__icons :global(svg) { width:1rem; height:1rem; }
  @media(max-width:640px) { .n0ct-site-footer { align-items:flex-start; flex-direction:column; } }
</style>
