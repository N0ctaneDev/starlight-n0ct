---
interface Props { type?: 'note' | 'tip' | 'warning' | 'danger' | 'info'; tone?: 'note' | 'tip' | 'warning' | 'danger' | 'info'; title?: string }
const { type, tone, title } = Astro.props;
const resolvedTone = tone ?? type ?? 'info';
const names = { note: 'Note', tip: 'Tip', warning: 'Warning', danger: 'Danger', info: 'Info' };
---
<aside class={`n0ct-callout n0ct-callout--${resolvedTone}`} data-tone={resolvedTone} role={resolvedTone === 'danger' || resolvedTone === 'warning' ? 'alert' : 'note'}>
  <div class="n0ct-callout__title">{title ?? names[resolvedTone]}</div>
  <div class="n0ct-callout__body"><slot /></div>
</aside>
<style>
  .n0ct-callout {
    --callout: var(--noct-cyan-500);
    margin-block: .8rem;
    padding: .58rem .72rem;
    border: 1px solid var(--noct-border);
    border-inline-start: 3px solid var(--callout);
    border-radius: var(--noct-radius-md);
    background:
      linear-gradient(125deg, color-mix(in srgb, var(--callout) 8%, transparent), transparent 62%),
      var(--noct-bg-surface);
    box-shadow: var(--noct-shadow-soft);
    font-size: .88rem;
    line-height: 1.55;
  }
  .n0ct-callout--note { --callout: var(--noct-text-muted); }
  .n0ct-callout--tip { --callout: var(--noct-success); }
  .n0ct-callout--warning { --callout: var(--noct-warning); }
  .n0ct-callout--danger { --callout: var(--noct-error); }
  .n0ct-callout--info { --callout: var(--noct-info); }
  .n0ct-callout__title {
    display: flex;
    align-items: center;
    gap: .4rem;
    margin: 0 0 .22rem;
    color: var(--callout);
    font-size: .86rem;
    font-weight: 680;
  }
  .n0ct-callout__body > :first-child { margin-top: 0; }
  .n0ct-callout__body > :last-child { margin-bottom: 0; }
  .n0ct-callout__body p { margin-block: .25rem; }
</style>
