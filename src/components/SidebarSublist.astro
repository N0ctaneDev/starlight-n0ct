---
import { Icon } from 'astro-icon/components';
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';

interface Entry {
  type: 'link' | 'group';
  label: string;
  href?: string;
  isCurrent?: boolean;
  attrs?: Record<string, unknown>;
  badge?: { text: string; variant?: string; class?: string };
  entries?: Entry[];
  collapsed?: boolean;
}
interface Props { sublist: Entry[]; nestedCount?: number }

const { sublist, nestedCount = 0 } = Astro.props;
const splitIcon = (label: string) => {
  const match = label.match(/^\[([^\]]+)\]\s*/);
  return { icon: match?.[1], text: match ? label.slice(match[0].length) : label };
};
const hasCurrent = (entry: Entry): boolean =>
  entry.type === 'link' ? Boolean(entry.isCurrent) : Boolean(entry.entries?.some(hasCurrent));
---
<ul class:list={['n0ct-sidebar-list', nestedCount > 0 && 'n0ct-sidebar-list--nested']}>
  {sublist.map((entry) => {
    const parsed = splitIcon(entry.label);
    if (entry.type === 'group') {
      const active = hasCurrent(entry);
      return (
        <li class:list={['n0ct-sidebar-group', active && 'is-active']}>
          <details open={active || !entry.collapsed}>
            <summary>
              {parsed.icon && <Icon name={parsed.icon} class="n0ct-sidebar-icon" />}
              <span class="n0ct-sidebar-label">{parsed.text}</span>
              {entry.badge && <span class:list={['n0ct-sidebar-badge', \`n0ct-badge--\${entry.badge.variant ?? 'default'}\`, entry.badge.class]}>{entry.badge.text}</span>}
              <svg class="n0ct-sidebar-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
            </summary>
            <SidebarRestorePoint />
            <Astro.self sublist={entry.entries ?? []} nestedCount={nestedCount + 1} />
          </details>
        </li>
      );
    }
    return (
      <li class:list={['n0ct-sidebar-link', entry.isCurrent && 'is-current']}>
        <a href={entry.href} aria-current={entry.isCurrent ? 'page' : undefined} {...entry.attrs}>
          {parsed.icon && <Icon name={parsed.icon} class="n0ct-sidebar-icon" />}
          <span class="n0ct-sidebar-label">{parsed.text}</span>
          {entry.badge && <span class:list={['n0ct-sidebar-badge', \`n0ct-badge--\${entry.badge.variant ?? 'default'}\`, entry.badge.class]}>{entry.badge.text}</span>}
        </a>
      </li>
    );
  })}
</ul>
<style is:global>
  .n0ct-sidebar-list { display:grid; gap:.2rem; margin:0; padding:0; list-style:none; }
  .n0ct-sidebar-list--nested { margin:.25rem 0 .35rem .75rem; padding-inline-start:.7rem; border-inline-start:1px solid var(--n0ct-border); }
  .n0ct-sidebar-group > details > summary,
  .n0ct-sidebar-link > a {
    display:flex; align-items:center; gap:.55rem; min-height:2.05rem; padding:.38rem .62rem;
    border-radius:var(--n0ct-radius-sm); color:var(--n0ct-text-secondary);
    text-decoration:none; font-size:.875rem; line-height:1.3; cursor:pointer;
    transition:color .15s ease, background-color .15s ease;
  }
  .n0ct-sidebar-group > details > summary { color:var(--n0ct-text-primary); font-weight:650; list-style:none; }
  .n0ct-sidebar-group > details > summary::-webkit-details-marker { display:none; }
  .n0ct-sidebar-link > a:hover,.n0ct-sidebar-group > details > summary:hover {
    color:var(--n0ct-text-primary); background:var(--n0ct-interactive-hover);
  }
  .n0ct-sidebar-link.is-current > a {
    color:var(--n0ct-text-primary);
    background:linear-gradient(100deg,color-mix(in srgb,var(--n0ct-primary-500) 17%,transparent),color-mix(in srgb,var(--n0ct-accent-500) 9%,transparent));
    box-shadow:inset 2px 0 var(--n0ct-accent-500);
  }
  .n0ct-sidebar-icon { flex:none; width:1rem; height:1rem; color:var(--n0ct-text-accent); }
  .n0ct-sidebar-label { min-width:0; overflow:hidden; text-overflow:ellipsis; }
  .n0ct-sidebar-chevron { flex:none; width:.8rem; margin-inline-start:auto; fill:none; stroke:currentColor; stroke-width:1.5; transition:transform .18s ease; }
  .n0ct-sidebar-group details[open] > summary .n0ct-sidebar-chevron { transform:rotate(180deg); }
  .n0ct-sidebar-badge {
    flex:none; margin-inline-start:auto; padding:.13rem .48rem;
    border:1px solid var(--n0ct-border); border-radius:999px;
    color:var(--n0ct-text-secondary); background:var(--n0ct-surface-elevated);
    font-size:.68rem; font-weight:650; line-height:1.25;
  }
  .n0ct-badge--success { color:var(--n0ct-success); border-color:color-mix(in srgb,var(--n0ct-success) 35%,var(--n0ct-border)); background:var(--n0ct-success-bg); }
  .n0ct-badge--danger { color:var(--n0ct-danger); border-color:color-mix(in srgb,var(--n0ct-danger) 35%,var(--n0ct-border)); background:var(--n0ct-danger-bg); }
  .n0ct-badge--tip { color:var(--n0ct-primary-400); border-color:color-mix(in srgb,var(--n0ct-primary-500) 35%,var(--n0ct-border)); background:color-mix(in srgb,var(--n0ct-primary-500) 10%,var(--n0ct-surface)); }
  .n0ct-badge--caution { color:var(--n0ct-warning); border-color:color-mix(in srgb,var(--n0ct-warning) 35%,var(--n0ct-border)); background:var(--n0ct-warning-bg); }
  .n0ct-sidebar-group > details > summary:focus-visible,.n0ct-sidebar-link > a:focus-visible { outline:2px solid var(--n0ct-border-focus); outline-offset:2px; }
  @media (prefers-reduced-motion:reduce) { .n0ct-sidebar-chevron { transition:none; } }
</style>
