---
import { Card, CardGrid } from '@astrojs/starlight/components';
import Callout from '@n0ctanedev/starlight-n0ct/components/docs/Callout.astro';
import DocCard from '@n0ctanedev/starlight-n0ct/components/docs/DocCard.astro';
import DocGrid from '@n0ctanedev/starlight-n0ct/components/docs/DocGrid.astro';
import FileTree from '@n0ctanedev/starlight-n0ct/components/docs/FileTree.astro';
import Kbd from '@n0ctanedev/starlight-n0ct/components/docs/Kbd.astro';
import Steps from '@n0ctanedev/starlight-n0ct/components/docs/Steps.astro';

const configuredTheme = (Astro.locals as any).n0ctane?.theme ?? {};
const configuredThemes = Array.isArray(configuredTheme.themes) ? configuredTheme.themes : [];
const sourceThemes = configuredThemes.length
  ? configuredThemes
  : [{ id: 'n0ctane', label: 'N0ctane', colors: {} }];
const playgroundThemes = sourceThemes.map((theme: {
  id: string;
  label: string;
  colors?: Record<string, unknown>;
}) => ({
  id: theme.id,
  label: theme.label,
  sourceColors: theme.colors ?? {},
}));
const defaultTheme = configuredTheme.defaultTheme ?? playgroundThemes[0]?.id ?? 'n0ctane';
---<section
  class="n0ct-theme-playground"
  data-n0ct-theme-playground
  data-themes={JSON.stringify(playgroundThemes)}
  data-default-theme={defaultTheme}
>
  <div class="n0ct-playground-toolbar">
    <div class="n0ct-playground-heading">
      <span class="n0ct-playground-eyebrow">Interactive designer</span>
      <h3>Theme playground</h3>
      <p>Edit your palette in one focused workspace. Core colors stay visible, detailed roles are grouped into expandable sections, and the live preview updates the actual documentation UI as you work.</p>
    </div>
    <div class="n0ct-playground-actions">
      <button type="button" class="n0ct-playground-button n0ct-playground-button--quiet" data-playground-reset>Reset palette</button>
      <button type="button" class="n0ct-playground-button" data-playground-copy>Copy config</button>
    </div>
  </div>

  <div class="n0ct-playground-workspace">
    <div class="n0ct-playground-editor">
  <div class="n0ct-playground-controls">
    <div class="n0ct-playground-selects">
      <label class="n0ct-playground-field">
        <span>Palette</span>
        <select data-playground-theme>
          {playgroundThemes.map((theme: { id: string; label: string }) => (
            <option value={theme.id} selected={theme.id === defaultTheme}>{theme.label}</option>
          ))}
        </select>
      </label>
      <label class="n0ct-playground-field">
        <span>Edit appearance</span>
        <select data-playground-mode>
          <option value="dark">Dark</option>
          <option value="light">Light</option>
        </select>
      </label>
    </div>
    <div class="n0ct-playground-core-fields" data-playground-core-fields></div>
    <details class="n0ct-playground-advanced">
      <summary>Advanced color roles</summary>
      <div data-playground-color-groups></div>
    </details>
    <details class="n0ct-playground-advanced">
      <summary>Gradients and shadows</summary>
      <p class="n0ct-playground-help">These values accept CSS gradient and box-shadow syntax. They are saved inside the selected theme's appearance mode.</p>
      <div data-playground-effect-groups></div>
    </details>
  </div>

  <div class="n0ct-playground-status" role="status" aria-live="polite" data-playground-status>
    Editing {playgroundThemes.find((theme: { id: string }) => theme.id === defaultTheme)?.label ?? 'N0ctane'} · Dark palette
  </div>

  <details class="n0ct-playground-code">
    <summary>View generated configuration</summary>
    <pre><code data-playground-config></code></pre>
  </details>

    </div>

  <div class="n0ct-playground-preview">
    <div class="n0ct-playground-preview-heading">
      <div>
        <span class="n0ct-playground-eyebrow">Live component preview</span>
        <h3>Interface surfaces</h3>
      </div>
      <span class="n0ct-playground-preview-mode" data-preview-mode>Dark · N0ctane</span>
    </div>

    <CardGrid>
      <Card title="Surface card" icon="pencil">
        A native Starlight card using the active page palette, with a readable neutral surface and primary focus color.
      </Card>
      <Card title="Interactive state" icon="mouse-pointer-click">
        Hover, focus, and select states derive from the accent and highlight roles.
      </Card>
      <Card title="Semantic feedback" icon="shield-check">
        Status tones remain distinct from the main brand colors.
      </Card>
    </CardGrid>

    <div class="n0ct-playground-preview-grid">
      <div class="n0ct-playground-callouts">
        <Callout tone="note" title="Note">Neutral context and secondary information.</Callout>
        <Callout tone="tip" title="Tip">Positive guidance and recommended actions.</Callout>
        <Callout tone="warning" title="Warning">A caution state using the warning semantic role.</Callout>
        <Callout tone="danger" title="Danger">A destructive or high-impact action.</Callout>
        <Callout tone="info" title="Information">A useful informational status message.</Callout>
      </div>
      <div class="n0ct-playground-sample-panel">
        <span class="n0ct-playground-eyebrow">Controls</span>
        <div class="n0ct-playground-button-row">
          <button class="n0ct-playground-button" type="button">Primary action</button>
          <button class="n0ct-playground-button n0ct-playground-button--quiet" type="button">Secondary</button>
        </div>
        <label class="n0ct-playground-field">
          <span>Text field</span>
          <input type="text" value="Palette-aware input" aria-label="Palette-aware input" />
        </label>
        <p class="n0ct-playground-sample-copy">Keyboard hint: <Kbd>Ctrl</Kbd> + <Kbd>K</Kbd></p>
        <p class="n0ct-playground-sample-copy"><a href="#named-themes">Accent link with a visible underline</a></p>
      </div>
    </div>

    <DocGrid columns={2}>
      <DocCard title="Documentation card" eyebrow="Surface" description="A reusable navigation card with accent text and a subtle glow." />
      <DocCard title="Another surface" eyebrow="Highlight" description="The card and its supporting text follow the selected palette." />
    </DocGrid>

    <Steps>
      <ol>
        <li>Change the primary or accent color to update the brand identity.</li>
        <li>Adjust the surface and text colors to tune the page contrast.</li>
        <li>Switch to Light to edit the independent light palette.</li>
      </ol>
    </Steps>

    <div class="n0ct-playground-sample-panel">
      <span class="n0ct-playground-eyebrow">File tree</span>
      <FileTree>
        <ul>
          <li>project
            <ul>
              <li>src
                <ul>
                  <li>components</li>
                  <li>styles</li>
                </ul>
              </li>
              <li>n0ct.config.mjs</li>
              <li>astro.config.mjs</li>
            </ul>
          </li>
        </ul>
      </FileTree>
    </div>

    <div class="n0ct-playground-sample-panel">
      <span class="n0ct-playground-eyebrow">Code surface</span>
      <pre class="n0ct-playground-code-sample"><code><span class="n0ct-code-comment">// Palette-aware code sample</span>
<span class="n0ct-code-keyword">const</span> theme = &#123;
  primary: palette.primary,
  accent: palette.accent,
  surface: palette.surface,
&#125;;
<span class="n0ct-code-keyword">export default</span> theme;</code></pre>
    </div>
  </div>
  </div>
</section>

<script>
  import { generateN0ctThemeCss, resolveN0ctThemeColors } from '@n0ctanedev/starlight-n0ct/theme-playground';

  type Mode = 'dark' | 'light';
  type Field = { label: string; paths: string[]; token: string };
  type FieldGroup = { label: string; fields: Field[] };
  type PlaygroundTheme = {
    id: string;
    label: string;
    sourceColors: Record<string, any>;
  };

  const coreGroup: FieldGroup = {
    label: 'Core palette',
    fields: [
      { label: 'Primary brand', paths: ['overrides.brand.primary', 'palette.primary'], token: '--n0ct-primary-500' },
      { label: 'Secondary brand', paths: ['overrides.brand.secondary', 'palette.secondary'], token: '--n0ct-secondary-500' },
      { label: 'Accent', paths: ['overrides.brand.accent', 'palette.accent'], token: '--n0ct-accent-500' },
      { label: 'Panel surface', paths: ['overrides.surfaces.surface', 'palette.surface'], token: '--n0ct-surface' },
      { label: 'Page background', paths: ['overrides.surfaces.base', 'palette.background'], token: '--n0ct-base' },
      { label: 'Main text', paths: ['overrides.text.primary', 'palette.text'], token: '--n0ct-text-primary' },
      { label: 'Highlight surface', paths: ['overrides.highlight.background', 'overrides.brand.highlight', 'palette.highlight'], token: '--n0ct-highlight' },
      { label: 'Highlight text', paths: ['overrides.highlight.text', 'overrides.brand.highlightText', 'palette.highlightText'], token: '--n0ct-highlight-text' },
    ],
  };

  const colorGroups: FieldGroup[] = [
    {
      label: 'Surfaces',
      fields: [
        ['Void', 'overrides.surfaces.void', '--n0ct-base-void'],
        ['Elevated', 'overrides.surfaces.elevated', '--n0ct-surface-elevated'],
        ['Sunken', 'overrides.surfaces.sunken', '--n0ct-surface-sunken'],
        ['Overlay', 'overrides.surfaces.overlay', '--n0ct-surface-overlay'],
        ['Navigation', 'overrides.surfaces.navigation', '--n0ct-surface-navigation'],
        ['Sidebar', 'overrides.surfaces.sidebar', '--n0ct-surface-sidebar'],
        ['Code surface', 'overrides.surfaces.code', '--n0ct-surface-code'],
      ].map(([label, path, token]) => ({ label, paths: [path], token })),
    },
    {
      label: 'Text roles',
      fields: [
        ['Secondary', 'overrides.text.secondary', '--n0ct-text-secondary'],
        ['Muted', 'overrides.text.muted', '--n0ct-text-muted'],
        ['Subtle', 'overrides.text.subtle', '--n0ct-text-subtle'],
        ['Inverse', 'overrides.text.inverse', '--n0ct-text-inverse'],
        ['Accent text', 'overrides.text.accent', '--n0ct-text-accent'],
        ['Highlight text role', 'overrides.text.highlight', '--n0ct-text-highlight'],
        ['Text on accent', 'overrides.text.onAccent', '--n0ct-text-on-accent'],
      ].map(([label, path, token]) => ({ label, paths: [path], token })),
    },
    {
      label: 'Borders',
      fields: [
        ['Subtle', 'overrides.borders.subtle', '--n0ct-border-subtle'],
        ['Default', 'overrides.borders.default', '--n0ct-border'],
        ['Strong', 'overrides.borders.strong', '--n0ct-border-strong'],
        ['Focus', 'overrides.borders.focus', '--n0ct-border-focus'],
      ].map(([label, path, token]) => ({ label, paths: [path], token })),
    },
    {
      label: 'Interactive states',
      fields: [
        ['Hover', 'overrides.interactive.hover', '--n0ct-interactive-hover'],
        ['Active', 'overrides.interactive.active', '--n0ct-interactive-active'],
        ['Selected', 'overrides.interactive.selected', '--n0ct-interactive-selected'],
      ].map(([label, path, token]) => ({ label, paths: [path], token })),
    },
    {
      label: 'Highlight and selection',
      fields: [
        ['Highlight border', 'overrides.highlight.border', '--n0ct-highlight-border'],
        ['Selection background', 'overrides.highlight.selectionBackground', '--n0ct-selection-background'],
        ['Selection text', 'overrides.highlight.selectionText', '--n0ct-selection-text'],
      ].map(([label, path, token]) => ({ label, paths: [path], token })),
    },
    {
      label: 'Semantic status colors',
      fields: (['success', 'warning', 'danger', 'info'] as const).flatMap((status) => [
        { label: status + ' foreground', paths: ['semantic.' + status + '.foreground'], token: '--n0ct-' + status },
        { label: status + ' background', paths: ['semantic.' + status + '.background'], token: '--n0ct-' + status + '-bg' },
        { label: status + ' border', paths: ['semantic.' + status + '.border'], token: '--n0ct-' + status + '-border' },
        { label: status + ' text', paths: ['semantic.' + status + '.text'], token: '--n0ct-' + status + '-text' },
      ]),
    },
    {
      label: 'Code frame roles',
      fields: [
        { label: 'Code background', paths: ['overrides.code.background', 'codePalette.background', 'overrides.surfaces.code'], token: '--n0ct-code-background' },
        { label: 'Code foreground', paths: ['overrides.code.foreground', 'codePalette.foreground'], token: '--n0ct-code-foreground' },
        { label: 'Cursor', paths: ['overrides.code.cursor'], token: '--n0ct-code-cursor' },
        { label: 'Selection', paths: ['overrides.code.selectionBackground'], token: '--n0ct-code-selection-background' },
        { label: 'Line highlight', paths: ['overrides.code.lineHighlight'], token: '--n0ct-code-line-highlight' },
        { label: 'Line numbers', paths: ['overrides.code.lineNumber'], token: '--n0ct-code-line-number' },
        { label: 'Active line number', paths: ['overrides.code.lineNumberActive'], token: '--n0ct-code-line-number-active' },
        { label: 'Added diff background', paths: ['overrides.code.diffAdded.background'], token: '--n0ct-code-diff-added-bg' },
        { label: 'Added diff text', paths: ['overrides.code.diffAdded.text'], token: '--n0ct-code-diff-added-text' },
        { label: 'Added diff border', paths: ['overrides.code.diffAdded.border'], token: '--n0ct-code-diff-added-border' },
        { label: 'Removed diff background', paths: ['overrides.code.diffRemoved.background'], token: '--n0ct-code-diff-removed-bg' },
        { label: 'Removed diff text', paths: ['overrides.code.diffRemoved.text'], token: '--n0ct-code-diff-removed-text' },
        { label: 'Removed diff border', paths: ['overrides.code.diffRemoved.border'], token: '--n0ct-code-diff-removed-border' },
        { label: 'Tab strip', paths: ['overrides.code.tabs.background'], token: '--n0ct-code-tabs-bg' },
        { label: 'Active tab', paths: ['overrides.code.tabs.activeBackground'], token: '--n0ct-code-tabs-active-bg' },
        { label: 'Tab text', paths: ['overrides.code.tabs.foreground'], token: '--n0ct-code-tabs-text' },
        { label: 'Active tab text', paths: ['overrides.code.tabs.activeForeground'], token: '--n0ct-code-tabs-active-text' },
        { label: 'Tab border', paths: ['overrides.code.tabs.border'], token: '--n0ct-code-tabs-border' },
      ],
    },
    {
      label: 'Syntax highlighting',
      fields: ['comment', 'keyword', 'string', 'number', 'function', 'type', 'variable', 'tag', 'attribute', 'punctuation', 'invalid']
        .map((role) => ({ label: role, paths: ['codePalette.' + role], token: '--n0ct-code-syntax-' + role })),
    },
  ];

  const effectGroups = [
    {
      label: 'Gradients',
      fields: [
        ['Brand gradient (text and lines)', 'brandGradient', '--n0ct-gradient-brand'],
        ['Divider override', 'effects.gradients.divider', '--n0ct-gradient-divider'],
        ['Brand soft fill', 'effects.gradients.brandSoft', '--n0ct-gradient-brand-soft'],
        ['Monochrome', 'effects.gradients.monochrome', '--n0ct-gradient-monochrome'],
        ['Accent', 'effects.gradients.accent', '--n0ct-gradient-accent'],
        ['Page glow', 'effects.gradients.canvas', '--n0ct-gradient-canvas'],
        ['Shimmer', 'effects.gradients.shimmer', '--n0ct-gradient-shimmer'],
        ['Callouts', 'effects.gradients.callout', '--n0ct-gradient-callout'],
        ['Cards', 'effects.gradients.card', '--n0ct-gradient-card'],
        ['Card hover', 'effects.gradients.cardHover', '--n0ct-gradient-card-hover'],
        ['Steps', 'effects.gradients.steps', '--n0ct-gradient-steps'],
        ['File tree', 'effects.gradients.fileTree', '--n0ct-gradient-file-tree'],
        ['Sidebar', 'effects.gradients.sidebar', '--n0ct-gradient-sidebar'],
        ['Active sidebar item', 'effects.gradients.sidebarActive', '--n0ct-gradient-sidebar-active'],
        ['Version selector', 'effects.gradients.versionSelect', '--n0ct-gradient-version-select'],
        ['Scrollbar', 'effects.gradients.scrollbar', '--n0ct-gradient-scrollbar'],
        ['Scrollbar hover', 'effects.gradients.scrollbarHover', '--n0ct-gradient-scrollbar-hover'],
      ],
    },
    {
      label: 'Shadows',
      fields: [
        ['Soft', 'effects.shadows.soft', '--n0ct-shadow-soft'],
        ['Floating', 'effects.shadows.float', '--n0ct-shadow-float'],
        ['Callout', 'effects.shadows.callout', '--n0ct-shadow-callout'],
        ['Card', 'effects.shadows.card', '--n0ct-shadow-card'],
        ['Card hover', 'effects.shadows.cardHover', '--n0ct-shadow-card-hover'],
        ['Controls', 'effects.shadows.control', '--n0ct-shadow-control'],
        ['Popovers', 'effects.shadows.popover', '--n0ct-shadow-popover'],
        ['Sidebar', 'effects.shadows.sidebar', '--n0ct-shadow-sidebar'],
        ['Active sidebar item', 'effects.shadows.sidebarActive', '--n0ct-shadow-sidebar-active'],
        ['Scrollbar thumb', 'effects.shadows.scrollbar', '--n0ct-shadow-scrollbar'],
        ['Scrollbar hover', 'effects.shadows.scrollbarHover', '--n0ct-shadow-scrollbar-hover'],
        ['Focus ring', 'effects.shadows.focus', '--n0ct-shadow-focus'],
        ['Selected code tab', 'effects.shadows.tab', '--n0ct-shadow-tab'],
        ['Wordmark', 'effects.shadows.wordmark', '--n0ct-shadow-wordmark'],
        ['Steps marker', 'effects.shadows.step', '--n0ct-shadow-step'],
      ],
    },
  ];

  function hasPath(source: Record<string, any>, path: string): boolean {
    return path.split('.').reduce((value, key) => value?.[key], source) !== undefined;
  }

  function getPath(source: Record<string, any>, path: string): unknown {
    return path.split('.').reduce((value, key) => value?.[key], source);
  }

  function setPath(source: Record<string, any>, path: string, value: string): void {
    const parts = path.split('.');
    let target = source;
    for (const part of parts.slice(0, -1)) {
      target[part] ??= {};
      target = target[part];
    }
    target[parts.at(-1)!] = value;
  }

  function cssColorToHex(value: string): string {
    if (/^#[\da-f]{6}$/i.test(value)) return value.toUpperCase();
    const probe = document.createElement('span');
    probe.style.color = value;
    document.body.append(probe);
    const resolved = getComputedStyle(probe).color;
    probe.remove();
    const channels = resolved.match(/[\d.]+/g)?.slice(0, 3).map(Number);
    if (!channels || channels.length !== 3) return '#808080';
    return '#' + channels.map((channel) => Math.round(channel).toString(16).padStart(2, '0')).join('').toUpperCase();
  }

  function initializeThemePlaygrounds() {
    document.querySelectorAll<HTMLElement>('[data-n0ct-theme-playground]').forEach((playground) => {
      if (playground.dataset.initialized === 'true') return;
      playground.dataset.initialized = 'true';

      const themes = JSON.parse(playground.dataset.themes ?? '[]') as PlaygroundTheme[];
      if (!themes.length) return;
      const originalThemes = JSON.parse(JSON.stringify(themes)) as PlaygroundTheme[];
      const themeSelect = playground.querySelector<HTMLSelectElement>('[data-playground-theme]');
      const modeSelect = playground.querySelector<HTMLSelectElement>('[data-playground-mode]');
      const colorHost = playground.querySelector<HTMLElement>('[data-playground-color-groups]');
      const coreHost = playground.querySelector<HTMLElement>('[data-playground-core-fields]');
      const effectHost = playground.querySelector<HTMLElement>('[data-playground-effect-groups]');
      const configOutput = playground.querySelector<HTMLElement>('[data-playground-config]');
      const status = playground.querySelector<HTMLElement>('[data-playground-status]');
      const previewMode = playground.querySelector<HTMLElement>('[data-preview-mode]');
      const styleId = 'n0ct-theme-playground-preview';
      let selectedTheme = playground.dataset.defaultTheme ?? themes[0]!.id;
      let selectedMode: Mode = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      const colorInputs: Array<{ input: HTMLInputElement; field: Field; isCore: boolean }> = [];
      const effectInputs: Array<{ input: HTMLInputElement; path: string; token: string }> = [];

      const getTheme = () => themes.find((theme) => theme.id === selectedTheme) ?? themes[0]!;
      const getMode = () => {
        const theme = getTheme();
        theme.sourceColors[selectedMode] ??= {};
        return theme.sourceColors[selectedMode] as Record<string, any>;
      };
      const themeLabel = () => getTheme().label || getTheme().id;

      const getThemeStyle = () => {
        let style = document.getElementById(styleId) as HTMLStyleElement | null;
        if (!style) {
          style = document.createElement('style');
          style.id = styleId;
          document.head.appendChild(style);
        }
        return style;
      };

      const resolvedVariables = () => resolveN0ctThemeColors(getTheme().sourceColors as never)[selectedMode].variables;

      const addColorGroup = (host: HTMLElement | null, group: FieldGroup, isCore = false) => {
        if (!host) return;
        const details = document.createElement('details');
        details.className = 'n0ct-playground-role-group';
        details.open = isCore;
        const summary = document.createElement('summary');
        summary.textContent = group.label;
        const grid = document.createElement('div');
        grid.className = 'n0ct-playground-field-grid';
        group.fields.forEach((field) => {
          const label = document.createElement('label');
          label.className = 'n0ct-playground-color';
          const input = document.createElement('input');
          input.type = 'color';
          input.setAttribute('aria-label', field.label);
          const text = document.createElement('span');
          const name = document.createElement('strong');
          name.textContent = field.label;
          const value = document.createElement('small');
          value.dataset.colorValue = field.token;
          text.append(name, value);
          label.append(input, text);
          grid.append(label);
          colorInputs.push({ input, field, isCore });
        });
        details.append(summary, grid);
        host.append(details);
      };

      const addEffectGroup = (host: HTMLElement | null, group: { label: string; fields: string[][] }) => {
        if (!host) return;
        const details = document.createElement('details');
        details.className = 'n0ct-playground-role-group';
        const summary = document.createElement('summary');
        summary.textContent = group.label;
        const grid = document.createElement('div');
        grid.className = 'n0ct-playground-effect-grid';
        group.fields.forEach(([labelText, path, token]) => {
          const label = document.createElement('label');
          label.className = 'n0ct-playground-effect';
          const name = document.createElement('span');
          name.textContent = labelText;
          const input = document.createElement('input');
          input.type = 'text';
          input.autocomplete = 'off';
          input.spellcheck = false;
          input.setAttribute('aria-label', labelText + ' CSS value');
          label.append(name, input);
          grid.append(label);
          effectInputs.push({ input, path, token });
        });
        details.append(summary, grid);
        host.append(details);
      };

      addColorGroup(coreHost, coreGroup, true);
      colorGroups.forEach((group) => addColorGroup(colorHost, group));
      effectGroups.forEach((group) => addEffectGroup(effectHost, group));

      const currentConfig = () => ({
        theme: {
          defaultTheme: selectedTheme,
          themes: {
            [selectedTheme]: {
              label: themeLabel(),
              colors: getTheme().sourceColors,
            },
          },
        },
      });

      const renderConfig = () => {
        if (configOutput) {
          configOutput.textContent = 'theme: ' + JSON.stringify(currentConfig().theme, null, 2).replace(/^/gm, '  ').trimStart();
        }
      };

      const pathForField = (field: Field) => field.paths.find((path) => hasPath(getMode(), path)) ?? field.paths[field.paths.length - 1]!;

      const syncInputs = () => {
        const variables = resolvedVariables();
        colorInputs.forEach(({ input, field }) => {
          const color = cssColorToHex(variables[field.token] ?? '#808080');
          input.value = color;
          const value = playground.querySelector<HTMLElement>('[data-color-value="' + field.token + '"]');
          if (value) value.textContent = color;
        });
        effectInputs.forEach(({ input, path, token }) => {
          const configured = getPath(getMode(), path);
          input.value = typeof configured === 'string' ? configured : variables[token] ?? '';
        });
        if (themeSelect) themeSelect.value = selectedTheme;
        if (modeSelect) modeSelect.value = selectedMode;
        if (previewMode) previewMode.textContent = selectedMode[0]!.toUpperCase() + selectedMode.slice(1) + ' · ' + themeLabel();
        if (status) status.textContent = 'Editing ' + themeLabel() + ' · ' + selectedMode[0]!.toUpperCase() + selectedMode.slice(1) + ' palette';
        renderConfig();
      };

      const applyPreview = () => {
        try {
          const css = generateN0ctThemeCss(getTheme().sourceColors as never)
            .replaceAll(':root', ':root[data-n0ct-playground]');
          getThemeStyle().textContent = css;
          document.documentElement.dataset.n0ctPlayground = 'true';
          renderConfig();
        } catch (error) {
          if (status) status.textContent = error instanceof Error ? error.message : 'Invalid theme value.';
        }
      };

      const clearPreview = () => {
        document.getElementById(styleId)?.remove();
        delete document.documentElement.dataset.n0ctPlayground;
      };

      const refresh = () => {
        syncInputs();
        applyPreview();
      };

      themeSelect?.addEventListener('change', () => {
        selectedTheme = themes.some((theme) => theme.id === themeSelect.value) ? themeSelect.value : themes[0]!.id;
        window.dispatchEvent(new CustomEvent('n0ct-theme:set-theme', { detail: selectedTheme }));
        refresh();
      });

      modeSelect?.addEventListener('change', () => {
        selectedMode = modeSelect.value === 'light' ? 'light' : 'dark';
        window.dispatchEvent(new CustomEvent('n0ct-theme:set-mode', { detail: selectedMode }));
        refresh();
      });

      colorInputs.forEach(({ input, field }) => input.addEventListener('input', () => {
        setPath(getMode(), pathForField(field), input.value.toUpperCase());
        refresh();
      }));

      effectInputs.forEach(({ input, path }) => input.addEventListener('change', () => {
        setPath(getMode(), path, input.value);
        refresh();
      }));

      playground.querySelector('[data-playground-reset]')?.addEventListener('click', () => {
        const original = originalThemes.find((theme) => theme.id === selectedTheme) ?? originalThemes[0]!;
        getTheme().sourceColors = JSON.parse(JSON.stringify(original.sourceColors)) as PlaygroundTheme['sourceColors'];
        clearPreview();
        refresh();
      });

      playground.querySelector('[data-playground-copy]')?.addEventListener('click', async () => {
        const configText = 'export default ' + JSON.stringify(currentConfig(), null, 2) + ';';
        try {
          await navigator.clipboard.writeText(configText);
          if (status) status.textContent = 'Copied the ' + themeLabel() + ' theme configuration.';
        } catch {
          if (status) status.textContent = 'Clipboard unavailable. Open “View generated configuration” and copy it manually.';
        }
      });

      window.addEventListener('n0ct:theme-change', (event) => {
        const detail = (event as CustomEvent<{ mode?: Mode; theme?: string }>).detail;
        if (detail.mode === 'light' || detail.mode === 'dark') selectedMode = detail.mode;
        if (detail.theme && themes.some((theme) => theme.id === detail.theme) && detail.theme !== selectedTheme) {
          selectedTheme = detail.theme;
          clearPreview();
        }
        syncInputs();
      });

      document.addEventListener('astro:before-preparation', clearPreview);

      const selected = document.documentElement.dataset.n0ctTheme;
      if (selected && themes.some((theme) => theme.id === selected)) selectedTheme = selected;
      refresh();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeThemePlaygrounds, { once: true });
  } else {
    initializeThemePlaygrounds();
  }
  document.addEventListener('astro:page-load', initializeThemePlaygrounds);
</script>


